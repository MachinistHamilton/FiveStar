# All paths are relative to this project, not the shell's working directory.
DATA_DIR=storage
MODEL_CACHE=models
OFFLINE=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=main
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_REVISION=main
# Advanced hybrid indexing only; ordinary UI search does not load these models.
EMBEDDING_DEVICE=cpu
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
CONTEXT_WINDOW=8192
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.1
# Requested Ollama inference threads, not a hard CPU-utilization cap.
INFERENCE_THREADS=2
CANDIDATE_COUNT=20
EVIDENCE_COUNT=6
RERANK_ENABLED=true
VERIFY_CLAIMS=true
# Requested target is clamped to the embedding model limit, minus special tokens.
CHUNK_TOKENS=650
CHUNK_OVERLAP=40
EMBEDDING_BATCH_SIZE=32
MAX_UPLOAD_MB=200
OCR_LANGUAGE=eng
# Optional path to Tesseract's tessdata directory; leave blank to use auto-discovery.
TESSDATA_PREFIX=
# Advanced CLI bulk indexing only. The UI always processes text without vision.
# Explicit single-page AI analysis uses VISION_MODEL even when this is false.
VISION_ENABLED=false
VISION_MODEL=qwen3-vl:4b-instruct
VISION_CONTEXT_WINDOW=16384
VISION_MAX_OUTPUT_TOKENS=2048
VISION_MAX_IMAGE_EDGE=1536
VISION_TIMEOUT_SECONDS=600
